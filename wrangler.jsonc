{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dfadv",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 정적 파일이 없는 경로 중 Worker가 처리해야 하는 것 (브라우저 페이지 이동은 지정하지 않으면 바로 404 페이지로 감)
    "run_worker_first": ["/api/*", "/rank", "/rank/*", "/data", "/statistics", "/statistics/*",
      "/calculator", "/enhance", "/amplify", "/guild"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dfadv",
      "database_id": "8066b804-ee7d-4c6d-ab69-2d581754e39e",
      "migrations_dir": "migrations"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dunyam.xyz", "custom_domain": true },
    { "pattern": "www.dunyam.xyz", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
